    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const navLinks = document.querySelectorAll('.sidebar nav ul li a');
            const sections = document.querySelectorAll('.section-content');
            const currentSectionTitle = document.getElementById('current-section-title');
            const productListBody = document.getElementById('product-list-body');
            const productFormContainer = document.getElementById('product-form-container');
            const productEditForm = document.getElementById('product-edit-form');
            const addProductBtn = document.getElementById('add-product-btn');
            const cancelProductFormBtn = document.getElementById('cancel-product-form');
            const formTitle = document.getElementById('form-title');
            const productIdInput = document.getElementById('product-id');
            const productNameInput = document.getElementById('product-name');
            const productDescriptionInput = document.getElementById('product-description');
            const productPriceInput = document.getElementById('product-price');
            const productStockInput = document.getElementById('product-stock');
            const productSizeSelect = document.getElementById('product-size');
            const productColorInput = document.getElementById('product-color');
            const productImageUrlInput = document.getElementById('product-image-url');

            // --- API Base URL ---
            const API_BASE_URL = 'http://localhost:3000/api/products'; // আমাদের ব্যাকএন্ডের URL

            // --- Function to Fetch Products from API ---
            async function fetchProducts() {
                try {
                    const response = await fetch(API_BASE_URL);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    const products = await response.json();
                    return products;
                } catch (error) {
                    console.error('Error fetching products:', error);
                    alert('পণ্য লোড করতে সমস্যা হয়েছে।');
                    return [];
                }
            }

            // --- Function to Render Product List ---
            async function renderProductList() {
                productListBody.innerHTML = ''; // Clear existing list
                const products = await fetchProducts(); // Fetch products from backend
                products.forEach(product => {
                    const row = productListBody.insertRow();
                    row.innerHTML = `
                        <td><img src="${product.imageUrl || 'https://via.placeholder.com/50/dddddd/000000?text=No+Img'}" alt="${product.name}"></td>
                        <td>${product.name}</td>
                        <td>${product.sizes ? product.sizes.join(', ') : ''}</td>
                        <td>${product.colors ? product.colors.join(', ') : ''}</td>
                        <td>${product.price.toLocaleString()} ৳</td>
                        <td>${product.stock}</td>
                        <td class="product-actions">
                            <button class="btn btn-secondary edit-product-btn" data-id="${product.id}"><i class="fas fa-edit"></i></button>
                            <button class="btn btn-danger delete-product-btn" data-id="${product.id}"><i class="fas fa-trash-alt"></i></button>
                        </td>
                    `;
                });
            }

            // --- Function to Populate Product Form for Editing ---
            async function populateProductForm(productId) {
                try {
                    const response = await fetch(`${API_BASE_URL}/${productId}`);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    const product = await response.json();
                    
                    formTitle.textContent = 'পণ্য সম্পাদনা করুন';
                    productIdInput.value = product.id;
                    productNameInput.value = product.name;
                    productDescriptionInput.value = product.desc;
                    productPriceInput.value = product.price;
                    productStockInput.value = product.stock;
                    
                    // Set selected sizes in the multiselect dropdown
                    Array.from(productSizeSelect.options).forEach(option => {
                        option.selected = product.sizes && product.sizes.includes(option.value);
                    });

                    productColorInput.value = product.colors ? product.colors.join(', ') : '';
                    productImageUrlInput.value = product.imageUrl || '';
                    
                    productFormContainer.style.display = 'block'; // Show the form
                    window.scrollTo({ top: productFormContainer.offsetTop - 100, behavior: 'smooth' }); // Scroll to form
                } catch (error) {
                    console.error('Error populating product form:', error);
                    alert('পণ্য লোড করতে সমস্যা হয়েছে।');
                }
            }

            // --- Function to Reset Product Form ---
            function resetProductForm() {
                formTitle.textContent = 'নতুন পণ্য যোগ করুন';
                productIdInput.value = '';
                productEditForm.reset(); // Resets all form fields
                Array.from(productSizeSelect.options).forEach(option => option.selected = false); // Clear selected sizes
                productFormContainer.style.display = 'none'; // Hide the form
            }

            // --- Navigation Logic ---
            navLinks.forEach(link => {
                link.addEventListener('click', async function(event) {
                    event.preventDefault(); // Prevent default anchor behavior

                    navLinks.forEach(item => item.classList.remove('active'));
                    this.classList.add('active');

                    const targetId = this.getAttribute('href').substring(1); // e.g., "dashboard-section"
                    const targetSection = document.getElementById(targetId);

                    sections.forEach(section => section.classList.remove('active')); // Hide all sections
                    if (targetSection) {
                        targetSection.classList.add('active'); // Show selected section

                        // Update header title based on navigation
                        currentSectionTitle.textContent = this.querySelector('span').textContent;
                        
                        // Scroll to top of main content (for better UX when switching sections)
                        document.querySelector('.main-content').scrollTo({ top: 0, behavior: 'smooth' });
                    }

                    // --- Dynamic Data/Function Calls based on Section ---
                    if (targetId === 'dashboard-section') {
                        // Simulate data update for dashboard (as in previous code)
                        setTimeout(() => {
                            const randomSales = (Math.random() * 50000 + 10000).toFixed(0);
                            const randomCustomers = (Math.random() * 20 + 30).toFixed(0);
                            document.getElementById('today-sales').textContent = `৳ ${parseInt(randomSales).toLocaleString()}`;
                            document.getElementById('new-customers').textContent = randomCustomers;
                        }, 500); // Simulate a small delay
                    } else if (targetId === 'products-section') {
                        await renderProductList(); // Render product list when products section is active
                        resetProductForm(); // Ensure form is hidden/reset when navigating to products list
                    }
                    // For other sections like 'sales-section', 'inventory-section', etc., you'd load their specific content here
                    // e.g., if (targetId === 'print-bill-section') { populateBillDetails(); }
                });
            });

            // --- Product Management Logic ---

            // "Add New Product" Button Click
            addProductBtn.addEventListener('click', function() {
                resetProductForm(); // Clear form for new entry
                productFormContainer.style.display = 'block'; // Show the product form
                formTitle.textContent = 'নতুন পণ্য যোগ করুন'; // Set form title
                window.scrollTo({ top: productFormContainer.offsetTop - 100, behavior: 'smooth' }); // Scroll to the form
            });

            // "Cancel" Button on Product Form Click
            cancelProductFormBtn.addEventListener('click', function() {
                resetProductForm(); // Hide and reset the form
            });

            // Event delegation for "Edit" and "Delete" buttons in the product list
            productListBody.addEventListener('click', async function(event) {
                if (event.target.closest('.edit-product-btn')) {
                    const productId = event.target.closest('.edit-product-btn').dataset.id;
                    await populateProductForm(productId);
                } else if (event.target.closest('.delete-product-btn')) {
                    const productId = event.target.closest('.delete-product-btn').dataset.id;
                    if (confirm('আপনি কি এই পণ্যটি মুছে ফেলতে নিশ্চিত?')) {
                        try {
                            const response = await fetch(`${API_BASE_URL}/${productId}`, {
                                method: 'DELETE',
                            });
                            if (!response.ok) {
                                throw new Error(`HTTP error! status: ${response.status}`);
                            }
                            alert('পণ্য সফলভাবে মুছে ফেলা হয়েছে!');
                            await renderProductList(); // Re-render the list after deletion
                        } catch (error) {
                            console.error('Error deleting product:', error);
                            alert('পণ্য মোছা সম্ভব হয়নি।');
                        }
                    }
                }
            });

            // Product Form Submission (Add/Edit)
            productEditForm.addEventListener('submit', async function(event) {
                event.preventDefault(); // Prevent default browser form submission

                const id = productIdInput.value;
                const name = productNameInput.value;
                const desc = productDescriptionInput.value;
                const price = parseFloat(productPriceInput.value);
                const stock = parseInt(productStockInput.value);
                const sizes = Array.from(productSizeSelect.selectedOptions).map(option => option.value);
                const colors = productColorInput.value.split(',').map(color => color.trim()).filter(color => color !== '');
                const imageUrl = productImageUrlInput.value;

                const productData = { name, desc, price, stock, sizes, colors, imageUrl };

                try {
                    let response;
                    if (id) {
                        // Edit existing product
                        response = await fetch(`${API_BASE_URL}/${id}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(productData),
                        });
                    } else {
                        // Add new product
                        response = await fetch(API_BASE_URL, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(productData),
                        });
                    }

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    alert('পণ্য সফলভাবে সংরক্ষিত হয়েছে!');
                    await renderProductList(); // Update the product list display in the table
                    resetProductForm(); // Hide and reset the form after submission
                } catch (error) {
                    console.error('Error saving product:', error);
                    alert('পণ্য সংরক্ষণ করতে সমস্যা হয়েছে।');
                }
            });

            // Initial render when the page loads (or when the products section is first navigated to)
            // It's called when 'products-section' is activated via navigation
        });
    </script>
</body>
